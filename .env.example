# Copy to .env or run scripts/start-demo.ps1 to generate local-only keys.
# Never use these demo credentials outside localhost.
LITELLM_MASTER_KEY=sk-replace-with-a-random-local-key
LITELLM_SALT_KEY=replace-with-a-random-local-salt
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql://litellm:replace-with-a-random-local-password@postgres:5432/litellm
